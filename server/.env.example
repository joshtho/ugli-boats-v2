# Environment Variables Template
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=3001

# Database Configuration  
DATABASE_PATH=./gallery.db

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Admin Configuration
ADMIN_PASSWORD=your-admin-password
ADMIN_PASSWORD_HASH=your-bcrypt-hashed-password
JWT_SECRET=your-32-character-random-secret

# Email Notification Configuration (Gmail SMTP)
# ADMIN_NOTIFY_EMAIL = who receives submission notifications
# GMAIL_USER = the Gmail account used to SEND emails
# GMAIL_APP_PASSWORD = App Password from Google (not your regular password)
ADMIN_NOTIFY_EMAIL=admin@example.com
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
